# Copy this file to .env and fill in your values.
# Get a free Gemini API key at https://aistudio.google.com/apikey

# --- LLM / Embeddings ---
GEMINI_API_KEY=your-gemini-api-key-here

# LLM provider: "ollama" (local, free) or "gemini" (API)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3:latest
OLLAMA_BASE_URL=http://localhost:11434

# Only used when LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Embedding provider: "local" (free, unlimited) or "gemini" (API, rate limits)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_BATCH_SIZE=64

# Only used when EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# --- Vector store ---
CHROMA_DIR=./storage/chroma
CHROMA_COLLECTION=finsight_docs

# --- Document storage ---
DOCUMENTS_DIR=./data/documents

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_TOP_K=5
COMPARISON_K_PER_COMPANY=4

# --- Frontend ---
FINSIGHT_API_URL=http://127.0.0.1:8000

# --- Embedding throughput (free-tier: ~100 requests/min) ---
# Smaller batches + longer delay = slower but safer on free tier.
EMBEDDING_BATCH_SIZE=10
EMBEDDING_BATCH_DELAY=70
